{
  "name": "eggd_msipro-score",
  "title": "eggd_msipro-score",
  "summary": "MSIsensor-pro tumour-only scoring against a panel-specific MSS baseline; applies the panel-calibrated 8.0% MSI-H threshold",
  "dxapi": "1.0.0",
  "version": "1.0.0",
  "properties": {
    "githubRelease": "1.0.0"
  },
  "whatsNew": "* v1.0.0 Initial release — renamed/promoted from cgp-msi-score; panel-calibrated 8.0% threshold (100% sensitivity/specificity on 26 labelled EF v1 specimens)",
  "inputSpec": [
    {
      "name": "tumour_bam",
      "label": "Tumour BAM",
      "class": "file",
      "optional": false,
      "patterns": ["*.bam"],
      "help": "Tumour-only BAM, chr-prefixed"
    },
    {
      "name": "tumour_bai",
      "label": "Tumour BAM index",
      "class": "file",
      "optional": false,
      "patterns": ["*.bai"],
      "help": "Index matching tumour_bam"
    },
    {
      "name": "sample_id",
      "label": "Sample ID",
      "class": "string",
      "optional": false,
      "help": "Sample identifier used to name the output TSV"
    },
    {
      "name": "msi_sites",
      "label": "Panel MSI site list",
      "class": "file",
      "optional": false,
      "patterns": ["*.txt"],
      "help": "cgp_msi_sites.txt output from eggd_msipro-baseline"
    },
    {
      "name": "baseline_tar",
      "label": "MSS baseline bundle",
      "class": "file",
      "optional": false,
      "patterns": ["*.tar.gz"],
      "help": "cgp_msi_baseline.tar.gz output from eggd_msipro-baseline"
    },
    {
      "name": "msisensor_pro",
      "label": "msisensor-pro binary",
      "class": "file",
      "optional": false,
      "help": "Pre-compiled msisensor-pro v1.3.0 executable"
    },
    {
      "name": "msi_threshold",
      "label": "MSI-H threshold (%)",
      "class": "float",
      "optional": true,
      "default": 8.0,
      "help": "Panel-calibrated unstable-site percentage cut-off for MSI-H (default 8.0%; NOT the generic msisensor-pro 20% default — see README for calibration)"
    }
  ],
  "outputSpec": [
    {
      "name": "msi_tsv",
      "label": "MSI score TSV",
      "class": "file",
      "patterns": ["*.msi.tsv"],
      "help": "<sample_id>.msi.tsv — sample_id, msi_score, total_sites, unstable_sites, msi_status, tool_version"
    }
  ],
  "runSpec": {
    "interpreter": "bash",
    "file": "src/code.sh",
    "distribution": "Ubuntu",
    "release": "24.04",
    "version": "0",
    "timeoutPolicy": {
      "*": {"hours": 2}
    },
    "assetDepends": [
      {
        "name": "htslib_suite_asset",
        "project": "project-Fkb6Gkj433GVVvj73J7x8KbV",
        "folder": "/app_assets/htslib/htslib_v1.22.0",
        "version": "1.22"
      }
    ]
  },
  "developers": ["org-emee_1"],
  "authorizedUsers": ["org-emee_1"],
  "access": {
    "project": "CONTRIBUTE"
  },
  "regionalOptions": {
    "aws:eu-central-1": {
      "systemRequirements": {
        "*": {"instanceType": "mem1_ssd1_v2_x2"}
      }
    }
  }
}
